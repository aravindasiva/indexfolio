# Local dev vars for apps/api. Copy to apps/api/.env and fill in. Never commit a .env.
# For staging/prod Prisma commands, create apps/api/.env.staging / .env.production
# (gitignored) with only DATABASE_URL set, then use the prisma:*:staging / :prod scripts.

DATABASE_URL=postgresql://indexfolio:indexfolio_dev@localhost:5432/indexfolio

REDIS_URL=redis://localhost:6379

# Optional, only needed when running pipeline workers.
TEMPORAL_ADDRESS=localhost:7233

# Optional, used by web app for server-side requests.
API_URL=http://localhost:3001

# Optional, comma-separated CORS origins beyond localhost:3000 and indexfolio.dev.
CORS_ORIGIN=

# Named PORT because most PaaS platforms inject this exact name automatically.
PORT=3001

NODE_ENV=development
