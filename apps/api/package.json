{
  "name": "@indexfolio/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/server.js",
    "start:prod": "pnpm prisma:deploy && node dist/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed:staging": "dotenv -e .env.staging -- prisma db seed",
    "prisma:seed:prod": "dotenv -e .env.production -- prisma db seed",
    "prisma:deploy:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "prisma:deploy:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.3.0",
    "prisma": "^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.7.0",
    "vitest": "^2.0.0"
  }
}
