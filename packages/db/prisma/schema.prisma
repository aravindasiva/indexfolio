// Prisma schema for Indexfolio
// Datasource: Neon Postgres (local Docker for dev)
// Generator: Prisma Client JS

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Build the Prisma engine for the local OS and for Debian (the Docker runtime).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// A fund, identified by its ISIN. Accumulating and distributing share classes have
// different ISINs, so they are separate rows. Exchange-specific data lives in Listing.
model ETF {
  id               String    @id @default(cuid())
  isin             String    @unique
  name             String
  domicile         String
  ter              Decimal
  fundSize         BigInt
  fundSizeCurrency String
  fundSizeEur      BigInt
  isAccumulating   Boolean
  isUcits          Boolean
  indexTracked     String?
  assetClass       String?
  provider         String
  inceptionDate    DateTime?
  kiidUrl          String?
  source           String?
  fetchedAt        DateTime?
  lastMetadataSync DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  listings         Listing[]
  holdings         Holding[]
}

// One row per exchange a fund trades on. The same fund lists on many venues with
// different tickers and currencies (IE00B4L5Y983 = EUNL@Xetra = SWDA@London).
model Listing {
  id                 String    @id @default(cuid())
  etfId              String
  etf                ETF       @relation(fields: [etfId], references: [id])
  exchangeMic        String
  exchange           Exchange  @relation(fields: [exchangeMic], references: [mic])
  ticker             String
  currency           String
  isPrimary          Boolean   @default(false)
  yahooSymbol        String?
  source             String?
  fetchedAt          DateTime?
  pricesBackfilledAt DateTime?
  // The venue whose full history powers the chart; stable + decoupled from isPrimary (display).
  isPriceAnchor      Boolean   @default(false)
  prices             Price[]

  @@unique([etfId, exchangeMic, currency])
  @@unique([exchangeMic, ticker])
}

// Reference: an exchange keyed by its ISO 10383 MIC, with a human display name and the
// raw source labels that map to it ("Xetra", "Deutsche Boerse" -> XETR).
model Exchange {
  mic      String    @id
  name     String
  aliases  String[]
  listings Listing[]
}

// Reference: a provider's canonical name and the raw source labels that map to it
// (BlackRock -> iShares, DWS -> Xtrackers). Ingestion uses it to normalise names.
model Provider {
  id      String   @id @default(cuid())
  name    String   @unique
  aliases String[]
}

model Holding {
  id       String   @id @default(cuid())
  etfId    String
  etf      ETF      @relation(fields: [etfId], references: [id])
  ticker   String
  name     String
  weight   Decimal
  country  String
  sector   String
  asOfDate DateTime

  @@index([etfId, asOfDate])
}

model Price {
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  close     Decimal
  adjClose  Decimal
  currency  String
  source    String?
  fetchedAt DateTime @default(now())

  // No surrogate id: (listingId, date) is the natural key and the time-series index.
  @@id([listingId, date])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  date         DateTime
  fromCurrency String
  toCurrency   String
  rate         Decimal

  @@unique([date, fromCurrency, toCurrency])
}

model PipelineRun {
  id               String    @id @default(cuid())
  pipeline         String
  status           String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorMessage     String?
  recordsProcessed Int?
}
