// Prisma schema for Indexfolio
// Datasource: Neon Postgres (local Docker for dev)
// Generator: Prisma Client JS

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Build the Prisma engine for the local OS and for Alpine/musl (the Docker runtime).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model ETF {
  id               String    @id @default(cuid())
  ticker           String    @unique
  isin             String
  name             String
  domicile         String
  exchange         String
  currency         String
  ter              Decimal
  fundSizeEur      BigInt
  isAccumulating   Boolean
  isUcits          Boolean
  indexTracked     String
  assetClass       String
  provider         String
  inceptionDate    DateTime
  kiidUrl          String?
  lastMetadataSync DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  holdings         Holding[]
  prices           Price[]

  @@unique([isin, ticker])
}

model Holding {
  id       String   @id @default(cuid())
  etfId    String
  etf      ETF      @relation(fields: [etfId], references: [id])
  ticker   String
  name     String
  weight   Decimal
  country  String
  sector   String
  asOfDate DateTime

  @@index([etfId, asOfDate])
}

model Price {
  id       String   @id @default(cuid())
  etfId    String
  etf      ETF      @relation(fields: [etfId], references: [id])
  date     DateTime
  close    Decimal
  currency String

  @@unique([etfId, date])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  date         DateTime
  fromCurrency String
  toCurrency   String
  rate         Decimal

  @@unique([date, fromCurrency, toCurrency])
}

model PipelineRun {
  id               String    @id @default(cuid())
  pipeline         String
  status           String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorMessage     String?
  recordsProcessed Int?
}
