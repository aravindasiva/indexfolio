# Local development environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to the repository.

# Supabase Postgres connection string (app database)
DATABASE_URL=postgresql://indexfolio:indexfolio_dev@localhost:5432/indexfolio

# Redis connection string (Railway in production, Docker locally)
REDIS_URL=redis://localhost:6379

# Temporal server address (Railway in production, Docker locally)
TEMPORAL_ADDRESS=localhost:7233

# Internal API base URL (used by the web app for server-side requests)
API_URL=http://localhost:3001

# Port the Fastify server listens on
PORT=3001

# Node environment
NODE_ENV=development
