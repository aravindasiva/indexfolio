{
  "name": "indexfolio",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @indexfolio/db generate",
    "db:migrate": "pnpm --filter @indexfolio/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @indexfolio/db migrate:deploy",
    "db:reset": "pnpm --filter @indexfolio/db reset",
    "db:seed": "pnpm --filter @indexfolio/db seed",
    "db:studio": "pnpm --filter @indexfolio/db studio",
    "kill:ports": "kill-port 5432 6379 3000 3001"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.65.0",
    "vercel": "^54.18.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
