# Local context files - never commit
COPILOT_CONTEXT.md
COPILOT_CURRENT_CONTEXT.md

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
# Auto-generated by next dev/build; its content flaps between dev and prod
# variants, so we never track it (regenerated on every build/dev, and tsc
# typechecks fine without it).
next-env.d.ts

# Build outputs
dist/
build/
coverage/

# Environment files, no real secrets should ever be committed.
# .env.example is explicitly allowed (placeholder values only, no secrets).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Turbo
.turbo

# Vercel
.vercel

# Local dev
.local/
.env*
*.tsbuildinfo
