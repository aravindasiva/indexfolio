# Local development environment variables for apps/api
# Copy this file to apps/api/.env and fill in real values.
# Never commit any .env file to the repository.
#
# For running Prisma commands against staging or production databases locally,
# create apps/api/.env.staging and apps/api/.env.production with only DATABASE_URL set.
# Both files are gitignored. Then use:
#   pnpm --filter @indexfolio/api prisma:deploy:staging
#   pnpm --filter @indexfolio/api prisma:deploy:prod
#   pnpm --filter @indexfolio/api prisma:seed:staging

# Postgres connection string
DATABASE_URL=postgresql://indexfolio:indexfolio_dev@localhost:5432/indexfolio

# Redis connection string
REDIS_URL=redis://localhost:6379

# Temporal server address - optional, only needed when running pipeline workers
TEMPORAL_ADDRESS=localhost:7233

# Internal API base URL - optional, used by web app for server-side requests
API_URL=http://localhost:3001

# Additional allowed CORS origins beyond localhost:3000 and indexfolio.dev
# Comma-separated list. Optional.
CORS_ORIGIN=

# Port the API server listens on.
# Named PORT because most PaaS platforms inject this exact name automatically.
PORT=3001

# Node environment
NODE_ENV=development
